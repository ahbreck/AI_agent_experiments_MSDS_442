# Required for LLM-backed routing and story handlers.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI-compatible endpoint settings.
# Example: https://api.openai.com/v1 (OpenAI), or your compatible provider base URL.
OPENAI_BASE_URL=
# Optional key alias for compatible providers. If OPENAI_API_KEY is set, it takes precedence.
OPENAI_COMPATIBLE_API_KEY=
# Optional fallback key used when your compatible endpoint does not require auth.
OPENAI_COMPATIBLE_DUMMY_API_KEY=not-needed

# Optional toggles used by some stories.
# Enable LLM planning path for Data Science story 2.
PROTOTYPE_DS2_USE_LLM_PLAN=0

# LLM model override for Data Science story 2 planner.
PROTOTYPE_DS2_PLAN_MODEL=gpt-4o-mini

# Enable LLM critic override for Data Science story 2 (0 = deterministic critic only).
PROTOTYPE_DS2_USE_LLM_CRITIC=0

# LLM model override for Data Science story 2 critic.
PROTOTYPE_DS2_CRITIC_MODEL=gpt-4o-mini

# Enable LLM interpretation synthesis for Data Science story 2.
PROTOTYPE_DS2_USE_LLM_INTERPRET=1

# LLM model override for Data Science story 2 interpretation.
PROTOTYPE_DS2_INTERPRET_MODEL=gpt-4o-mini

# Optional toggles for Business Marketing story 2.
PROTOTYPE_BM2_USE_LLM_PLAN=1
PROTOTYPE_BM2_PLAN_MODEL=gpt-4o-mini
PROTOTYPE_BM2_CRITIC_MODEL=gpt-4o-mini

# Optional toggles for Data Science story 3 hybrid planning.
# Enable LLM planner when deterministic uncertainty is high enough.
PROTOTYPE_DS3_USE_LLM_PLAN=0
PROTOTYPE_DS3_PLAN_MODEL=gpt-4o-mini
PROTOTYPE_DS3_UNCERTAINTY_THRESHOLD=0.45
PROTOTYPE_DS3_LLM_MIN_CONF=0.55
